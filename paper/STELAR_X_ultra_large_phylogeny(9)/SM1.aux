\@writefile{lot}{\contentsline {table}{\numberline {S3}{\ignorespaces The Jensen-Shannon divergence with respect to the true gene trees for different model conditions averaged over all replicates. The best-performing method (i.e., the least amount of divergence) for each model condition has been highlighted in bold.}}{3}{table.caption.4}\protected@file@percent }
\newlabel{tab:37-divergence}{{S3}{3}{The Jensen-Shannon divergence with respect to the true gene trees for different model conditions averaged over all replicates. The best-performing method (i.e., the least amount of divergence) for each model condition has been highlighted in bold}{table.caption.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S4}{\ignorespaces Average quartet scores of estimated species trees and the true tree with respect to the estimated gene trees for the 37-taxon dataset. For wQFM+QT-WEAVER, we also report the quartet score with respect to the corrected estimated quartet distribution. The highest scores among the estimated trees have been italicized, and the scores closest to the true tree are shown in bold.}}{3}{table.caption.5}\protected@file@percent }
\newlabel{tab:37-quartet-scores-estimated}{{S4}{3}{Average quartet scores of estimated species trees and the true tree with respect to the estimated gene trees for the 37-taxon dataset. For wQFM+QT-WEAVER, we also report the quartet score with respect to the corrected estimated quartet distribution. The highest scores among the estimated trees have been italicized, and the scores closest to the true tree are shown in bold}{table.caption.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S5}{\ignorespaces Average quartet scores of estimated species trees and the true tree with respect to the true gene trees for the 37-taxon dataset. The highest scores among the estimated trees have been italicized, and the scores closest to the true tree are shown in bold. }}{4}{table.caption.6}\protected@file@percent }
\newlabel{tab:37-quartet-scores-true}{{S5}{4}{Average quartet scores of estimated species trees and the true tree with respect to the true gene trees for the 37-taxon dataset. The highest scores among the estimated trees have been italicized, and the scores closest to the true tree are shown in bold}{table.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces \textbf  {Results on 37-taxon dataset.} We show the average RF rates with standard errors over 20 replicates for the methods ASTRAL, wQFM (wQFM-uncorrected), wQFM+QT-WEAVER (wQFM-corrected), wQMC (wQMC-uncorrected), and wQMC+QT-WEAVER (wQMC-corrected). The settings in (a)-(c) are identical to the ones in Figure \ref {journal-fig:rf_37_taxon_methods} in the main paper. }}{4}{figure.caption.7}\protected@file@percent }
\newlabel{fig:rf_37_taxon_wqmc}{{S2}{4}{\textbf {Results on 37-taxon dataset.} We show the average RF rates with standard errors over 20 replicates for the methods ASTRAL, wQFM (wQFM-uncorrected), wQFM+QT-WEAVER (wQFM-corrected), wQMC (wQMC-uncorrected), and wQMC+QT-WEAVER (wQMC-corrected). The settings in (a)-(c) are identical to the ones in Figure \ref {journal-fig:rf_37_taxon_methods} in the main paper}{figure.caption.7}{}}
